<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WinKit.App</RootNamespace>
    <AssemblyName>WinKit</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 全部为 .NET Framework 自带程序集，不进输出目录 -->
    <Reference Include="System.Management" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.VisualBasic" />
    <!-- AI 模块用（本工程以源码链接方式编译 Platform，因此引用要在这里也声明一次） -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <!--
    单文件发布的关键一步：这里**不**用 ProjectReference 引用 WinKit.Core / WinKit.Platform，
    而是把这两个工程的**源码**直接编译进 WinKit.exe。

    为什么这么做：
    - ProjectReference 会把 WinKit.Core.dll / WinKit.Platform.dll 复制到输出目录，
      那就变成 3 个文件的"绿色文件夹"，而不是承诺的单个 exe。
    - 合并成单文件有三条路：ILRepack / Costura.Fody（都要联网装构建期工具），
      或者自己写 AssemblyResolve 从嵌入资源加载（运行时魔法，启动失败很难查）。
      直接链接源码是最朴素、最可复现、零外部工具的一条路。
    - 分层纪律并未丢失：WinKit.Core 工程依然独立存在且**没有** WPF 引用，
      谁在 Core 里写了 WPF 或 P/Invoke，Core 工程编译就会失败。
      Core/Platform 工程同时继续被两个测试工程引用，保证可独立单测。

    注意 Compat\IsExternalInit.cs 被排除：App 工程自己有一份同名 polyfill，
    两份都编进同一个程序集会导致类型重复定义（CS0101）。
  -->
  <ItemGroup>
    <Compile Include="..\WinKit.Core\**\*.cs"
             Exclude="..\WinKit.Core\bin\**;..\WinKit.Core\obj\**;..\WinKit.Core\Compat\IsExternalInit.cs">
      <Link>LinkedSource\Core\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\WinKit.Platform\**\*.cs"
             Exclude="..\WinKit.Platform\bin\**;..\WinKit.Platform\obj\**">
      <Link>LinkedSource\Platform\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
