<Window x:Class="WinKit.App.Views.Ai.AiPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinKit.App.ViewModels"
        Width="720"
        Height="620"
        MinWidth="560"
        MinHeight="480"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{DynamicResource AppFontFamily}">

    <Window.Resources>
        <vm:BoolToVisibility x:Key="BoolToVisibility" />
        <vm:BoolToVisibilityInverted x:Key="BoolToVisibilityInverted" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
          ① 披露条：为什么放最上面、最显眼？
          用户判断"要不要点发送"的唯一依据就是"这次到底发出去什么"。
          把它压在按钮附近或者折叠起来，等于让用户在不知情的情况下做决定，
          所以它必须是第一眼看到的东西，且用 WarningBrush 做视觉强调。
        -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource WarningBrush}"
                BorderThickness="3,0,0,0"
                CornerRadius="{DynamicResource CornerRadiusSmall}"
                Padding="10,8"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="本次将发送到 DeepSeek 服务的内容："
                           FontFamily="{DynamicResource AppFontFamily}"
                           FontSize="{DynamicResource FontSizeNormal}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WarningBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding Disclosure}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasDisclosure, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!-- ② 可编辑的待发送正文 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="将发送的内容（可以修改）"
                       FontFamily="{DynamicResource AppFontFamily}"
                       FontSize="{DynamicResource FontSizeNormal}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,4" />
            <TextBox Style="{StaticResource AppTextBoxStyle}"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Height="200"
                     Text="{Binding UserMessageText, UpdateSourceTrigger=PropertyChanged}" />
            <!-- 用户改内容时如果触发了自动脱敏，必须明说，不能让"被替换"悄悄发生 -->
            <TextBlock Text="注意：以上内容里疑似用户名 / 计算机名 / 密钥的片段已被自动替换为占位符，编辑框里显示的就是将要发送的文本。"
                       Foreground="{DynamicResource WarningBrush}"
                       FontFamily="{DynamicResource AppFontFamily}"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasRedactionNotice, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ③ 系统指令：默认可收起，但用户随时能展开逐字核对 -->
        <Expander Grid.Row="2"
                  Header="查看随请求一起发送的系统指令（不可修改）"
                  Foreground="{DynamicResource TextSecondaryBrush}"
                  FontSize="{DynamicResource FontSizeSmall}"
                  Margin="0,0,0,10">
            <TextBox Style="{StaticResource AppTextBoxStyle}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="{DynamicResource FontSizeSmall}"
                     Height="130"
                     Margin="0,6,0,0"
                     Text="{Binding SystemPromptText, Mode=OneWay}" />
        </Expander>

        <!-- ④ 动作行：字符数在左，复制/发送/关闭在右 -->
        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left"
                       Text="{Binding CharacterCountText}"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Content="关闭"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Click="OnCloseClick" />
            <Button DockPanel.Dock="Right"
                    Content="{Binding SendButtonText}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding IsSendAvailable}"
                    Command="{Binding SendCommand}" />
            <Button DockPanel.Dock="Right"
                    Content="复制回复"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"
                    Command="{Binding CopyReplyCommand}" />
        </DockPanel>

        <!--
          ⑤ 回复区用 TextBox 而不是 TextBlock：
          流式追加时 TextBlock 会因重新测量/布局而闪烁，TextBox 只是往文本缓冲里追加，
          而且用户能选中、复制回复内容。
        -->
        <DockPanel Grid.Row="4" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top"
                       Text="回复"
                       FontFamily="{DynamicResource AppFontFamily}"
                       FontSize="{DynamicResource FontSizeNormal}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,4" />
            <TextBox Style="{StaticResource AppTextBoxStyle}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding ReplyText, Mode=OneWay}" />
        </DockPanel>

        <!-- ⑥ 状态行 -->
        <TextBlock Grid.Row="5"
                   Text="{Binding StatusText}"
                   Style="{StaticResource CaptionTextStyle}"
                   Margin="2,8,0,0"
                   TextWrapping="Wrap" />
    </Grid>
</Window>
